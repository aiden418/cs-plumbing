{
  "name": "cs-plumbing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "postinstall": "node scripts/build-image-manifest.mjs --quiet || true",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "node scripts/build-image-manifest.mjs --quiet",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check:claims": "node scripts/check-content-claims.mjs --strict",
    "check:legacy": "node scripts/check-legacy-classes.mjs --strict",
    "prebuild": "node scripts/check-deploy-env.mjs && node scripts/build-image-manifest.mjs && npm run check:claims && node scripts/check-images.mjs --gate",
    "preview:review": "NEXT_PUBLIC_ANALYTICS=off NEXT_PUBLIC_GA_MEASUREMENT_ID=off npm run build && OPENAI_ADS_CONVERSIONS_API_KEY= SMS_GATEWAY_TO= npm run start:capture -- -p 3100",
    "video:build": "node scripts/build-hero-video.mjs",
    "video:check": "node scripts/build-hero-video.mjs --check",
    "qa:snapshot": "node scripts/qa/snapshot.mjs",
    "qa:diff": "node scripts/qa/diff-snapshots.mjs",
    "qa:sweep": "node scripts/qa/sweep.mjs",
    "qa:vitals": "node scripts/qa/vitals.mjs",
    "qa:capture": "node scripts/qa/capture.mjs",
    "qa:print": "node scripts/qa/print-check.mjs",
    "images:manifest": "node scripts/build-image-manifest.mjs",
    "photos": "node scripts/ingest-project-photos.mjs && node scripts/ingest-gallery-photos.mjs && node scripts/build-image-manifest.mjs",
    "photos:ingest": "node scripts/ingest-project-photos.mjs",
    "photos:check": "node scripts/check-images.mjs",
    "gallery:ingest": "node scripts/ingest-gallery-photos.mjs",
    "photos:strip": "node scripts/strip-image-metadata.mjs",
    "builders:pdf": "node scripts/build-builder-pdfs.mjs",
    "start:capture": "RESEND_API_KEY=re_local_capture RESEND_CAPTURE=.resend-capture.jsonl NODE_OPTIONS=\"--require ./scripts/resend-capture.cjs\" next start"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.23",
    "lucide-react": "^0.563.0",
    "next": "^16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.38.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
