# Resend API key — used for transactional email from contact/booking/quote forms.
# Get one at https://resend.com/api-keys (verified domain: csplumbinglee.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email-to-SMS gateway address (carrier gateway, e.g. 10digits@vtext.com for
# Verizon). Each form submission sends a short text to it. Leave blank to
# disable SMS. Set the real number in Vercel only; never commit a phone number.
SMS_GATEWAY_TO=

# Test-mail redirect for Preview and local builds only. The live site ignores it:
# production office copies always go to office@csplumbinglee.com
# (officeRecipient() in src/lib/api/secure.ts). Leave blank to use that inbox.
ADMIN_EMAIL=

# Google Places API key — drives the live rating/review count in the schema,
# the homepage reviews strip and /reviews. Without it every surface falls back
# to the hand-maintained BUSINESS.reviewCount, which drifts (it sat at 46 while
# Google showed 60). The lookup runs server-side, so in Google Cloud Console
# restrict the key by API (Places API only), NOT by HTTP referrer — a referrer
# restriction blocks server calls and the site silently falls back.
GOOGLE_PLACES_API_KEY=
# Optional override. Defaults to BUSINESS.googlePlaceId (the 951 Pondella Rd listing).
GOOGLE_PLACE_ID=

# Google Analytics 4 Measurement ID. Optional override — the code defaults to
# G-2V9GN3FQ5B (the csplumbinglee.com web stream, see src/lib/pixel.ts), so
# leave this blank unless the stream changes. Set to "off" to disable the tag.
# Inlined at build time: after changing it in Vercel, redeploy. Accepted forms
# reach GA4 as generate_lead (builder bids as builder_lead); call and text taps
# and the coupon button are interactions: phone_tap / text_tap / coupon_click.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Review-mode switch for the three browser tags: GA4 + Google Ads, the Meta
# pixel and the OpenAI pixel (see analyticsMode() in src/lib/pixel.ts).
# Leave it blank wherever real visitors go. Blank, unset or any value other
# than the two below means the tags load exactly as in production.
#   off          No tag and no tracking beacon is rendered, and nothing is sent
#                to Google, Meta or OpenAI from the browser. For review previews
#                and form tests. Covers GA too, whatever the variable above says.
#   placeholder  The tags load as in production but with made-up ids, so the
#                weight of the vendors' scripts can be measured without the tags
#                reporting to the real properties. For measuring only: never
#                submit a form in a placeholder build, because a delivered
#                inquiry can still report the real Google Ads conversion.
# Inlined at build time, like the GA id: set it when `next build` runs (in
# Vercel, redeploy after changing it). Setting it only for `next start` does
# not turn the tags off. It does not touch the server-side OpenAI Conversions
# API below; leave that key blank in a review environment as well.
# NEVER set this in the Production environment.
NEXT_PUBLIC_ANALYTICS=

# OpenAI Ads (ChatGPT ads) Conversions API — server-side copy of lead_created /
# appointment_scheduled, deduped against the browser pixel by event id.
# Create the key in Ads Manager under the pixel's Conversions API settings.
# Server-only: never expose with a NEXT_PUBLIC_ prefix. Leave blank to disable.
OPENAI_ADS_CONVERSIONS_API_KEY=
# Set to "true" only for a smoke test: OpenAI validates the payload without recording it.
OPENAI_ADS_CAPI_VALIDATE_ONLY=
# Canonical site origin used to build source_url (defaults to https://www.csplumbinglee.com).
OPENAI_ADS_SITE_ORIGIN=

# Water heater giveaway: optional log of every entry as one row (no photos).
# A Google Apps Script web-app URL that appends the posted JSON to a sheet;
# setup steps are in docs/forms-and-photos.md. Leave blank to skip: entries
# always reach the office inbox either way.
GIVEAWAY_SHEET_WEBHOOK_URL=

# Water heater giveaway: entries sheet. BLOB_READ_WRITE_TOKEN is set by Vercel
# when the private Blob store is connected to the project (entries are saved
# there, without photos). GIVEAWAY_EXPORT_KEY (24+ random characters) guards
# /api/giveaway/export, which the Google Sheet imports. Both blank locally:
# entries are then not stored and the export answers 404.
BLOB_READ_WRITE_TOKEN=
GIVEAWAY_EXPORT_KEY=
