# Resend API key — used for transactional email from contact/booking/quote forms.
# Get one at https://resend.com/api-keys (verified domain: csplumbinglee.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email-to-SMS gateway address. Currently using Verizon (vtext.com).
# Form submissions trigger an SMS to this address. Leave blank to disable SMS.
SMS_GATEWAY_TO=2393146991@vtext.com

# Admin recipient for form-submission emails. Defaults to aiden@csplumbinglee.com if unset.
ADMIN_EMAIL=aiden@csplumbinglee.com

# Google Places API key — drives the live rating/review count in the schema,
# the homepage reviews strip and /reviews. Without it every surface falls back
# to the hand-maintained BUSINESS.reviewCount, which drifts (it sat at 46 while
# Google showed 60). The lookup runs server-side, so in Google Cloud Console
# restrict the key by API (Places API only), NOT by HTTP referrer — a referrer
# restriction blocks server calls and the site silently falls back.
GOOGLE_PLACES_API_KEY=
# Optional override. Defaults to BUSINESS.googlePlaceId (the 951 Pondella Rd listing).
GOOGLE_PLACE_ID=

# Google Analytics 4 Measurement ID. Optional override — the code defaults to
# G-2V9GN3FQ5B (the csplumbinglee.com web stream, see src/lib/pixel.ts), so
# leave this blank unless the stream changes. Set to "off" to disable the tag.
# Inlined at build time: after changing it in Vercel, redeploy. Call/text/form/
# booking conversions reach GA4 as contact / generate_lead / book_appointment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OpenAI Ads (ChatGPT ads) Conversions API — server-side copy of lead_created /
# appointment_scheduled, deduped against the browser pixel by event id.
# Create the key in Ads Manager under the pixel's Conversions API settings.
# Server-only: never expose with a NEXT_PUBLIC_ prefix. Leave blank to disable.
OPENAI_ADS_CONVERSIONS_API_KEY=
# Set to "true" only for a smoke test: OpenAI validates the payload without recording it.
OPENAI_ADS_CAPI_VALIDATE_ONLY=
# Canonical site origin used to build source_url (defaults to https://www.csplumbinglee.com).
OPENAI_ADS_SITE_ORIGIN=
