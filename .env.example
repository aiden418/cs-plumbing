# Resend API key — used for transactional email from contact/booking/quote forms.
# Get one at https://resend.com/api-keys (verified domain: csplumbinglee.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email-to-SMS gateway address. Currently using Verizon (vtext.com).
# Form submissions trigger an SMS to this address. Leave blank to disable SMS.
SMS_GATEWAY_TO=2393146991@vtext.com

# Admin recipient for form-submission emails. Defaults to aiden@csplumbinglee.com if unset.
ADMIN_EMAIL=aiden@csplumbinglee.com

# Google Places API key — used by the homepage Google Reviews embed (optional).
# Restrict by HTTP referrer to https://*.csplumbinglee.com/* in Google Cloud Console.
# Leave blank to render the static testimonials fallback only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# OpenAI Ads (ChatGPT ads) Conversions API — server-side copy of lead_created /
# appointment_scheduled, deduped against the browser pixel by event id.
# Create the key in Ads Manager under the pixel's Conversions API settings.
# Server-only: never expose with a NEXT_PUBLIC_ prefix. Leave blank to disable.
OPENAI_ADS_CONVERSIONS_API_KEY=
# Set to "true" only for a smoke test: OpenAI validates the payload without recording it.
OPENAI_ADS_CAPI_VALIDATE_ONLY=
# Canonical site origin used to build source_url (defaults to https://www.csplumbinglee.com).
OPENAI_ADS_SITE_ORIGIN=
# ── Analytics ──────────────────────────────────────────────────────────
# All three are public (they ship to the browser) and all three are optional:
# if an ID is unset, that tag simply does not render.

# GA4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX.
# GA4 is configured directly via NEXT_PUBLIC_GA4_ID above — do NOT also add a
# GA4 configuration tag inside GTM, or every event is counted twice. Use GTM
# for Google Ads conversions and other third-party tags, triggered off the
# dataLayer events pushed from src/lib/analytics.ts.
NEXT_PUBLIC_GTM_ID=

# Meta Pixel ID. Defaults to the currently live pixel if unset.
NEXT_PUBLIC_META_PIXEL_ID=
