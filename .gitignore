# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/images/projects/mangos-bathroom-remodel/final/*.MOV

# photo-inbox: raw uploads and generated snippets are staging only.
# The folder structure + README stay; finished WebP goes to public/images/projects.
photo-inbox/**/*.jpg
photo-inbox/**/*.jpeg
photo-inbox/**/*.png
photo-inbox/**/*.webp
photo-inbox/**/*.avif
photo-inbox/**/*.heic
photo-inbox/**/*.heif
photo-inbox/**/*.tif
photo-inbox/**/*.tiff
photo-inbox/**/*.JPG
photo-inbox/**/*.JPEG
photo-inbox/**/*.PNG
photo-inbox/**/*.HEIC
photo-inbox/_generated/
